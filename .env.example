# ASTRA configuration. Copy to .env and adjust. Never commit real secrets.

# --- Server ---------------------------------------------------------------
APP_NAME=ASTRA
# "development" enables auto-reload when started with `python -m backend.main`.
ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated origins allowed to call the API from another host (empty = same-origin only).
CORS_ORIGINS=

# --- Storage --------------------------------------------------------------
# Default: sqlite:///<project>/data/astra.db
DATABASE_URL=
# Default: <project>/datasets  (acquired real data subsets + provenance)
DATASETS_DIR=
# Default: <project>/data/reports  (generated PDF reports)
REPORTS_DIR=

# --- External data ---------------------------------------------------------
# Timeout for NASA POWER / Planetary Computer / PDS requests.
HTTP_TIMEOUT_SECONDS=60
# How long cached NASA POWER responses are reused.
POWER_CACHE_TTL_HOURS=720

# --- Research agent (optional) --------------------------------------------
# none      -> deterministic research assistant (no external calls)
# anthropic -> Claude via the Anthropic API; needs LLM_API_KEY or ANTHROPIC_API_KEY
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=60
